{
  "name": "@toeicknot/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn app.main:app --reload --port 8000 --host 127.0.0.1",
    "start": "uv run uvicorn app.main:app --port 8000 --host 0.0.0.0",
    "lint": "uv run ruff check .",
    "test": "uv run pytest",
    "clean": "rm -rf .pytest_cache __pycache__ app/**/__pycache__ .ruff_cache"
  }
}
